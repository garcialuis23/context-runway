{
  "name": "context-runway",
  "displayName": "Context Runway",
  "description": "See your Claude Code context window runway and account rate-limit burn-rate at a glance in VS Code.",
  "version": "0.1.0",
  "publisher": "context-runway",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/garcialuis23/context-runway.git",
    "directory": "extension"
  },
  "categories": ["Other"],
  "keywords": ["claude", "claude code", "context window", "rate limit", "usage", "anthropic"],
  "galleryBanner": {
    "color": "#1a1a19",
    "theme": "dark"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "context-runway.showPanel",
        "title": "Context Runway: Show Usage Panel"
      },
      {
        "command": "context-runway.openRawLog",
        "title": "Context Runway: Open Raw Usage Log"
      },
      {
        "command": "context-runway.clearHistory",
        "title": "Context Runway: Clear Usage History"
      }
    ],
    "configuration": {
      "title": "Context Runway",
      "properties": {
        "context-runway.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Opt in to anonymous usage telemetry (which commands you run — no file paths, no usage numbers, no other personal data). Off by default. Also requires VS Code's own `#telemetry.telemetryLevel#` setting to be `all` or `error`; if that's `off`, nothing is sent regardless of this setting."
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package",
    "test": "node --test"
  },
  "license": "MIT"
}
